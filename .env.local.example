# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Each *_API_KEY below accepts a comma-separated list (e.g. "key1,key2") to
# rotate to the next key on that provider's own HTTP 429 before giving up on
# it — a single value with no comma works exactly as one key always has.
GEMINI_API_KEY=
# Server-only Llama fallback. Gemini is always called first; Meta Llama is
# used only after every configured Gemini key has returned HTTP 429.
# LLAMA_MODEL is optional: when it is blank, Petpet selects the first model
# currently enabled for whichever Llama key is being tried.
LLAMA_API_KEY=
LLAMA_MODEL=
# Server-only OpenRouter fallback — third in line, used only if every
# configured Llama key also fails (missing key, its own rate limit, or any
# other error). OPENROUTER_MODEL is optional; defaults to a free model (see
# ai-provider.ts). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional image-understanding override. The default alias always resolves to
# OpenRouter's current Google Gemini Flash model with multimodal input support.
OPENROUTER_VISION_MODEL=~google/gemini-flash-latest

# The feeder's credential is NOT here. Each device has its own secret, stored
# hashed in the devices table and in plaintext only in the firmware's
# config.h — see docs/HARDWARE.md. The hardware authenticates with the public
# anon key above plus that secret; it never sees the service-role key.
