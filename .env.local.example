# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Server-only Llama fallback. Gemini is always called first; Meta Llama is
# used only after Gemini returns HTTP 429. LLAMA_MODEL is optional: when it is
# blank, Petpet selects the first model currently enabled for this Llama key.
LLAMA_API_KEY=
LLAMA_MODEL=
# Server-only OpenRouter fallback — third in line, used only if Llama also
# fails (missing key, its own rate limit, or any other error). OPENROUTER_MODEL
# is optional; defaults to a free model (see ai-provider.ts). Get a key at
# https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# The feeder's credential is NOT here. Each device has its own secret, stored
# hashed in the devices table and in plaintext only in the firmware's
# config.h — see docs/HARDWARE.md. The hardware authenticates with the public
# anon key above plus that secret; it never sees the service-role key.
